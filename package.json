{
  "private": false,
  "displayName": "Homebridge Loxone Proxy",
  "name": "homebridge-loxone-proxy",
  "version": "1.0.6",
  "description": "Homebridge Dynamic Platform Plugin which exposes a Loxone System to Homekit.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudyberends/homebridge-loxone-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/rudyberends/homebridge-loxone-proxy/issues"
  },
  "engines": {
    "homebridge": "^1.7.0 || ^2.0.0-beta.0",
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "Loxone",
    "Loxone connect",
    "homebridge",
    "homebridge-plugin",
    "HomeKit"
  ],
  "dependencies": {
    "@homebridge/camera-utils": "^3.0.0",
    "ffmpeg-for-homebridge": "^2.2.0",
    "loxone-ts-api": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@types/sharp": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "homebridge": "^1.11.0",
    "nodemon": "^3.1.10",
    "npm-check-updates": "^19.0.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.2.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "Master",
        "prerelease": false
      },
      {
        "name": "beta",
        "prerelease": true
      }
    ]
  }
}
